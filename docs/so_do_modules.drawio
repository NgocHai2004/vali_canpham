        <mxCell id="fl-c7" value="Check trùng?&#10;CCCD / vân tay" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="480" width="180" height="80" as="geometry" />
