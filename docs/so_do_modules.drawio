        <mxCell id="fle4" value="Sai" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;fontSize=10;fontColor=#991B1B;" edge="1" parent="1" source="fl-l-pw" target="fl-l-errpw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fle4b" value="thử lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;dashed=1;fontSize=10;fontColor=#991B1B;" edge="1" parent="1" source="fl-l-errpw" target="fl-l-form"><mxGeometry relative="1" as="geometry" /></mxCell>
