  <diagram name="3 · Luồng nghiệp vụ" id="page-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fl-title" value="LUỒNG NGHIỆP VỤ — Đăng nhập &amp; Đăng ký can phạm" style="text;html=1;fontSize=20;fontStyle=1;align=center;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="480" y="20" width="700" height="36" as="geometry" />
        </mxCell>

        <!-- ===== LUỒNG ĐĂNG NHẬP ===== -->
        <mxCell id="fl-g-login" value="A · ĐĂNG NHẬP (2 lớp bảo mật)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#3730A3;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="500" height="720" as="geometry" />
        </mxCell>

        <mxCell id="fl-start" value="Mở app (localhost:5173)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="130" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl-l-token" value="Có token còn hạn? (8h)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="210" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fl-l-form" value="Nhập user + password&#10;POST /api/auth/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fl-l-pw" value="Đúng mật khẩu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="95" y="420" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fl-l-errpw" value="✖ Sai user/mật khẩu&#10;→ nhập lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="340" y="425" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fl-l-dongle" value="LỚP 2: Kiểm USB dongle&#10;GET /api/auth/dongle-verify" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="530" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fl-l-errd" value="✖ Không có dongle / service lỗi&#10;→ auth.clear(), báo lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="340" y="540" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fl-l-ok" value="✔ Vào Dashboard&#10;+ nền: poll dongle 5s, rút USB → tự logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=11;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="110" y="660" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- ===== LUỒNG ĐĂNG KÝ CAN PHẠM ===== -->
        <mxCell id="fl-g-cap" value="B · ĐĂNG KÝ CAN PHẠM (DataCapturePage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#9A3412;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="90" width="620" height="720" as="geometry" />
        </mxCell>

        <mxCell id="fl-c0" value="Mở phiên làm việc&#10;POST /api/sessions → bấm &quot;Đăng ký can phạm&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="130" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl-c1" value="① Quét CCCD (chip)&#10;máy quét → /api/cccd/push&#10;FE long-poll → tự điền form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="210" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fl-c2" value="② Chụp chân dung 3 góc&#10;camera + /api/face/recognize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="210" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fl-c3" value="③ Lăn vân tay 10 ngón&#10;fingerprint_service (USB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="300" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fl-c4" value="④ Chụp mống mắt (trái/phải)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="300" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fl-c5" value="⑤ Đo cao + cân nặng&#10;máy cân → /api/weight/push&#10;WebSocket đẩy realtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fl-c6" value="⑥ Nhập bổ sung&#10;mã can phạm, buồng, tội danh, ngày vào" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="380" width="270" height="70" as="geometry" />
