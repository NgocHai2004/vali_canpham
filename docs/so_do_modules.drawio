        <mxCell id="fl-c-warn" value="⚠ DuplicateWarnModal&#10;→ xác nhận / huỷ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=10;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="1010" y="490" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fl-c8" value="💾 Lưu hồ sơ&#10;POST /api/detainees → gắn vào phiên hiện tại&#10;ảnh lưu uploads/, dữ liệu vào MongoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;fontStyle=1;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="720" y="600" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fl-c9" value="Đóng phiên → xuất báo cáo (report) · export Excel · in PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="700" width="420" height="50" as="geometry" />
