<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="Sơ đồ luồng App_CCCD" id="cccd-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= TIÊU ĐỀ ================= -->
        <mxCell id="title" value="SƠ ĐỒ LUỒNG DỰ ÁN — App_CCCD (Quản lý can phạm)" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Đăng nhập (2 lớp bảo mật) → Kiểm tra điều kiện → Dashboard → Rẽ nhánh tính năng theo tab &amp; theo quyền" style="text;html=1;fontSize=13;align=center;verticalAlign=middle;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="360" y="58" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- ================= KHỐI 1: ĐĂNG NHẬP ================= -->
        <mxCell id="grp-auth" value="1 · ĐĂNG NHẬP &amp; ĐIỀU KIỆN VÀO APP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#3730A3;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="520" height="900" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Mở app&#10;http://localhost:5173" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="150" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="check-token" value="Đã có token còn hạn?&#10;(TTL 8 giờ)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="190" y="245" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="login-form" value="Màn hình đăng nhập&#10;— Nhập Username + Password&#10;— POST /api/auth/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="380" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="check-pw" value="Đúng tài khoản /&#10;mật khẩu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="480" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="err-pw" value="✖ Báo lỗi&#10;&quot;Sai tài khoản/mật khẩu&quot;&#10;→ nhập lại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="360" y="485" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="check-dongle" value="LỚP 2: Kiểm USB dongle&#10;GET /api/auth/dongle-verify" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="600" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="err-dongle" value="✖ Chưa cắm USB dongle&#10;(hoặc USB service lỗi 503)&#10;→ auth.clear() + báo lỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;fontColor=#991B1B;" vertex="1" parent="1">
          <mxGeometry x="360" y="610" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ok-auth" value="✔ Đủ điều kiện vào app&#10;(Token hợp lệ + USB dongle OK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=12;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="120" y="750" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="poll" value="⏱ NỀN: poll dongle mỗi 5 giây&#10;— 401 (rút USB / clone) → TỰ ĐĂNG XUẤT&#10;— 503 (service lỗi) → chỉ cảnh báo&#10;— lỗi mạng → cảnh báo, không logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=10;fontColor=#6B21A8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="850" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- ================= KHỐI 2: DASHBOARD + RẼ NHÁNH ================= -->
        <mxCell id="dashboard" value="2 · DASHBOARD&#10;(sau khi vào app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0EA5E9;strokeColor=#0369A1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="690" y="150" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="role-note" value="Phân quyền: admin (thấy đủ + Người dùng) · user/cán bộ (không có tab Người dùng)" style="text;html=1;fontSize=11;align=center;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="238" width="340" height="30" as="geometry" />
        </mxCell>

        <!-- Nhánh tính năng -->
        <mxCell id="f-dashboard" value="📊 Tổng quan (Dashboard)&#10;— Thống kê /api/stats&#10;— Số phiên, can phạm, biểu đồ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f-sessions" value="🗂 Phiên làm việc (Sessions)&#10;— Mở/đóng phiên (SessionOpenModal)&#10;— Danh sách, chi tiết, báo cáo&#10;— /api/sessions ...  · report · close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="390" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="f-detainees" value="📁 Can phạm (Detainees)&#10;— Danh sách, xem/sửa/xoá hồ sơ&#10;— Chuyển buồng (transfer)&#10;— Xuất/nhập Excel, in PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="f-cells" value="🚪 Buồng giam (Cells)&#10;— Thêm/sửa/xoá buồng&#10;— /api/cells" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="610" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f-search" value="🔎 Tra cứu (Search)&#10;— Theo tên/CCCD/mã can phạm&#10;— Check trùng, match vân tay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="700" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f-history" value="🕘 Lịch sử can phạm&#10;— detainee_history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="790" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="f-logs" value="📜 Nhật ký (Logs)&#10;— /api/logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="870" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="f-users" value="👥 Người dùng (Users) — CHỈ ADMIN&#10;— Thêm/sửa/xoá user, avatar&#10;— /api/users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=11;fontColor=#9D174D;" vertex="1" parent="1">
          <mxGeometry x="640" y="950" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- ================= KHỐI 3: LUỒNG ĐĂNG KÝ CAN PHẠM (DataCapture) ================= -->
        <mxCell id="grp-capture" value="3 · ĐĂNG KÝ CAN PHẠM MỚI (DataCapturePage) — luồng thu thập sinh trắc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#9A3412;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="620" height="530" as="geometry" />
        </mxCell>

        <mxCell id="cap-start" value="Bấm &quot;Đăng ký can phạm&quot;&#10;(từ tab Phiên / Can phạm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="345" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cap-cccd" value="① Quét CCCD (chip)&#10;— máy quét ngoài POST /api/cccd/push&#10;— FE long-poll → tự điền form&#10;(họ tên, số CCCD, quê quán...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="425" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cap-portrait" value="② Chụp chân dung đa góc&#10;— thẳng / trái / phải (camera)&#10;— nhận diện khuôn mặt /api/face" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="425" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cap-fp" value="③ Lăn vân tay (5 trái + 5 phải)&#10;— fingerprint_service (USB)&#10;— FingerprintEnrollModal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="525" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cap-iris" value="④ Chụp mống mắt&#10;— iris trái / phải" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="525" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cap-measure" value="⑤ Đo chiều cao + cân nặng&#10;— máy cân ngoài POST /api/weight/push&#10;— WebSocket đẩy realtime → tự điền" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="615" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cap-extra" value="⑥ Nhập bổ sung&#10;— mã can phạm, buồng giam, tội danh&#10;— ngày vào, đặc điểm nhận dạng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="615" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cap-save" value="💾 Lưu hồ sơ&#10;— check trùng CCCD/vân tay (DuplicateWarnModal)&#10;— POST /api/detainees → gắn vào phiên hiện tại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=11;fontStyle=1;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1080" y="710" width="420" height="70" as="geometry" />
        </mxCell>

