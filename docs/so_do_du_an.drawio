        <mxCell id="grp-dev" value="THIẾT BỊ / DỊCH VỤ NGOÀI (LAN nội bộ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#334155;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
